{
  "name": "dcf-builder-model",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dcf": "tsx --tsconfig tsconfig.json src/cli.ts",
    "dcf-mcp": "tsx --tsconfig tsconfig.json src/mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.unit.config.ts",
    "test:live": "tsx --tsconfig tsconfig.json scripts/require_live_deps.ts && vitest run --config vitest.live.config.ts",
    "test:all": "vitest run",
    "test:filing-agent": "tsx --tsconfig tsconfig.json scripts/check_filing_agent_accession.ts"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^2.1.5"
  }
}
